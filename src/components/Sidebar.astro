---
const { currentPath = '/' } = Astro.props;

// 1) 决定当前激活的顶层 section（与顶导 调研/实践指南/组织推广/模板 对齐）
const activeSection = (() => {
  if (currentPath.startsWith('/research')) return 'research';
  if (currentPath.startsWith('/handbook')) return 'handbook';
  if (currentPath.startsWith('/strategy')) return 'strategy';
  if (currentPath.startsWith('/templates')) return 'templates';
  return null;
})();

const isActive = (section: string) => activeSection === section;
const isCurrent = (href: string) => currentPath === href;
---

<nav class="sidebar-nav" aria-label="侧边栏导航" data-active-section={activeSection ?? ''}>
  <input
    class="sidebar-search"
    type="search"
    placeholder="🔍 过滤链接…"
    aria-label="过滤侧边栏链接"
    autocomplete="off"
    spellcheck="false"
  />

  <details data-section="research" data-active={isActive('research')} open={isActive('research')}>
    <summary>
      <span class="summary-left">
        <span class="arrow" aria-hidden="true"></span>
        <svg class="summary-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span class="summary-label">调研</span>
      </span>
    </summary>
    <div class="subsection-label">全局</div>
    <ul>
      <li><a href="/research/landscape" class={isCurrent('/research/landscape') ? 'active' : ''}>行业全景图</a></li>
    </ul>
    <div class="subsection-label">核心辩论</div>
    <ul>
      <li><a href="/research/vibe-vs-spec" class={isCurrent('/research/vibe-vs-spec') ? 'active' : ''}>Vibe vs Spec 辩论</a></li>
    </ul>
    <div class="subsection-label">工具生态</div>
    <ul>
      <li><a href="/research/agent-ecosystem" class={isCurrent('/research/agent-ecosystem') ? 'active' : ''}>Coding Agent 生态</a></li>
      <li><a href="/research/openspec-in-production" class={isCurrent('/research/openspec-in-production') ? 'active' : ''}>OpenSpec 生产调优</a></li>
      <li><a href="/research/full-stack-trend-2026" class={isCurrent('/research/full-stack-trend-2026') ? 'active' : ''}>全栈化趋势 2026</a></li>
    </ul>
    <div class="subsection-label">关键技能</div>
    <ul>
      <li><a href="/research/context-engineering" class={isCurrent('/research/context-engineering') ? 'active' : ''}>上下文工程（行业视角）</a></li>
      <li><a href="/research/quality-metrics" class={isCurrent('/research/quality-metrics') ? 'active' : ''}>AI 代码质量度量</a></li>
    </ul>
    <div class="subsection-label">边界与风险</div>
    <ul>
      <li><a href="/research/ai-boundaries" class={isCurrent('/research/ai-boundaries') ? 'active' : ''}>AI 能力边界</a></li>
      <li><a href="/research/security" class={isCurrent('/research/security') ? 'active' : ''}>安全与合规</a></li>
      <li><a href="/research/hard-data" class={isCurrent('/research/hard-data') ? 'active' : ''}>硬数据与事故</a></li>
    </ul>
    <div class="subsection-label">实践参照</div>
    <ul>
      <li><a href="/research/company-cases" class={isCurrent('/research/company-cases') ? 'active' : ''}>大厂案例</a></li>
    </ul>
    <div class="subsection-label">组织与基础设施</div>
    <ul>
      <li><a href="/research/transformation" class={isCurrent('/research/transformation') ? 'active' : ''}>团队转型路线图</a></li>
      <li><a href="/research/infrastructure-impact" class={isCurrent('/research/infrastructure-impact') ? 'active' : ''}>基础设施影响</a></li>
    </ul>
  </details>

  <details data-section="handbook" data-active={isActive('handbook')} open={isActive('handbook')}>
    <summary>
      <span class="summary-left">
        <span class="arrow" aria-hidden="true"></span>
        <svg class="summary-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        <span class="summary-label">实践指南</span>
      </span>
    </summary>
    <div class="subsection-label">入门</div>
    <ul>
      <li><a href="/handbook/why" class={isCurrent('/handbook/why') ? 'active' : ''}>为什么需要这套流程</a></li>
      <li><a href="/handbook/ai-as-amplifier" class={isCurrent('/handbook/ai-as-amplifier') ? 'active' : ''}>AI 是放大器不是工程师</a></li>
      <li><a href="/handbook/first-task-sop" class={isCurrent('/handbook/first-task-sop') ? 'active' : ''}>第一单 SOP</a></li>
    </ul>
    <div class="subsection-label">Spec 工程化</div>
    <ul>
      <li><a href="/handbook/workflow" class={isCurrent('/handbook/workflow') ? 'active' : ''}>6 步工作流</a></li>
      <li><a href="/handbook/spec-format" class={isCurrent('/handbook/spec-format') ? 'active' : ''}>Spec 字段规范</a></li>
      <li><a href="/handbook/clarification" class={isCurrent('/handbook/clarification') ? 'active' : ''}>澄清循环</a></li>
      <li><a href="/handbook/lint-protocol" class={isCurrent('/handbook/lint-protocol') ? 'active' : ''}>AI Lint 协议</a></li>
      <li><a href="/handbook/spec-to-code" class={isCurrent('/handbook/spec-to-code') ? 'active' : ''}>Spec 到代码</a></li>
    </ul>
    <div class="subsection-label">协作模式</div>
    <ul>
      <li><a href="/handbook/contract-first" class={isCurrent('/handbook/contract-first') ? 'active' : ''}>契约优先分工</a></li>
      <li><a href="/handbook/constitution" class={isCurrent('/handbook/constitution') ? 'active' : ''}>Constitution 模式</a></li>
      <li><a href="/handbook/team-roles" class={isCurrent('/handbook/team-roles') ? 'active' : ''}>团队角色与协作</a></li>
      <li><a href="/handbook/anti-patterns" class={isCurrent('/handbook/anti-patterns') ? 'active' : ''}>反模式与失败模式</a></li>
      <li><a href="/handbook/lessons" class={isCurrent('/handbook/lessons') ? 'active' : ''}>项目交付教训</a></li>
    </ul>
    <div class="subsection-label">工具体系</div>
    <ul>
      <li><a href="/handbook/tool-stack" class={isCurrent('/handbook/tool-stack') ? 'active' : ''}>工具体系地图</a></li>
      <li><a href="/handbook/context-engineering" class={isCurrent('/handbook/context-engineering') ? 'active' : ''}>上下文工程（工具实践）</a></li>
      <li><a href="/handbook/quality-gate" class={isCurrent('/handbook/quality-gate') ? 'active' : ''}>质量门工具</a></li>
      <li><a href="/handbook/internal-tools" class={isCurrent('/handbook/internal-tools') ? 'active' : ''}>内部工具建设</a></li>
      <li><a href="/handbook/why-spec-driven-dev" class={isCurrent('/handbook/why-spec-driven-dev') ? 'active' : ''}>Spec-Driven-Dev 定位</a></li>
      <li><a href="/handbook/full-stack-team-model" class={isCurrent('/handbook/full-stack-team-model') ? 'active' : ''}>全员全栈团队模式</a></li>
      <li><a href="/handbook/tools" class={isCurrent('/handbook/tools') ? 'active' : ''}>工具选型清单</a></li>
    </ul>
    <div class="subsection-label">实战场景</div>
    <ul>
      <li><a href="/handbook/unfamiliar-codebase" class={isCurrent('/handbook/unfamiliar-codebase') ? 'active' : ''}>陌生代码库协作</a></li>
      <li><a href="/handbook/parallel-sessions" class={isCurrent('/handbook/parallel-sessions') ? 'active' : ''}>多 AI 会话并行</a></li>
      <li><a href="/handbook/time-management" class={isCurrent('/handbook/time-management') ? 'active' : ''}>时间管理</a></li>
      <li><a href="/handbook/async-nightly" class={isCurrent('/handbook/async-nightly') ? 'active' : ''}>夜间异步执行</a></li>
      <li><a href="/handbook/docs-sync-strategy" class={isCurrent('/handbook/docs-sync-strategy') ? 'active' : ''}>文档同步策略</a></li>
    </ul>
  </details>

  <details data-section="strategy" data-active={isActive('strategy')} open={isActive('strategy')}>
    <summary>
      <span class="summary-left">
        <span class="arrow" aria-hidden="true"></span>
        <svg class="summary-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        <span class="summary-label">组织推广</span>
      </span>
    </summary>
    <div class="subsection-label">试点与推广</div>
    <ul>
      <li><a href="/strategy/pilot-playbook" class={isCurrent('/strategy/pilot-playbook') ? 'active' : ''}>AI 试点负责人 Playbook</a></li>
      <li><a href="/strategy/pilot-lessons" class={isCurrent('/strategy/pilot-lessons') ? 'active' : ''}>试点复盘案例</a></li>
      <li><a href="/research/transformation" class={isCurrent('/research/transformation') ? 'active' : ''}>团队转型路线图</a></li>
    </ul>
  </details>

  <details data-section="templates" data-active={isActive('templates')} open={isActive('templates')}>
    <summary>
      <span class="summary-left">
        <span class="arrow" aria-hidden="true"></span>
        <svg class="summary-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        <span class="summary-label">模板</span>
      </span>
    </summary>
    <div class="subsection-label">立项与契约</div>
    <ul>
      <li><a href="/templates/spec" class={isCurrent('/templates/spec') ? 'active' : ''}>Spec 模板</a></li>
      <li><a href="/templates/constitution" class={isCurrent('/templates/constitution') ? 'active' : ''}>Constitution 模板</a></li>
      <li><a href="/templates/contract" class={isCurrent('/templates/contract') ? 'active' : ''}>契约模板</a></li>
      <li><a href="/templates/system-prompt" class={isCurrent('/templates/system-prompt') ? 'active' : ''}>System Prompt 模板</a></li>
    </ul>
    <div class="subsection-label">执行与检查</div>
    <ul>
      <li><a href="/templates/lint-prompts" class={isCurrent('/templates/lint-prompts') ? 'active' : ''}>AI Lint Prompt</a></li>
      <li><a href="/templates/task-card" class={isCurrent('/templates/task-card') ? 'active' : ''}>任务卡模板</a></li>
      <li><a href="/templates/checklist" class={isCurrent('/templates/checklist') ? 'active' : ''}>流程 Checklist</a></li>
      <li><a href="/templates/circuit-breaker" class={isCurrent('/templates/circuit-breaker') ? 'active' : ''}>熔断 Checklist</a></li>
    </ul>
    <div class="subsection-label">度量与改进</div>
    <ul>
      <li><a href="/templates/metrics" class={isCurrent('/templates/metrics') ? 'active' : ''}>度量模板</a></li>
    </ul>
  </details>
</nav>

<script>
  // 1) 页面加载时，把当前激活的链接滚到 sidebar 视野中间
  const activeLink = document.querySelector<HTMLAnchorElement>('.sidebar-nav a.active');
  if (activeLink) {
    requestAnimationFrame(() => {
      activeLink.scrollIntoView({ block: 'center' });
    });
  }

  // 2) 记住每个 section 的初始 open 状态（SSR 渲染的默认值），
  //    用于过滤清空后恢复
  const initialOpenState = new Map<string, boolean>();
  document.querySelectorAll<HTMLDetailsElement>('.sidebar-nav details').forEach(d => {
    initialOpenState.set(d.dataset.section || '', d.open);
  });

  // 3) 搜索过滤：输入时隐藏不匹配项 + 自动展开含匹配项的 section
  const search = document.querySelector<HTMLInputElement>('.sidebar-search');
  if (search) {
    const applyFilter = () => {
      const q = search.value.toLowerCase().trim();
      document.querySelectorAll<HTMLLIElement>('.sidebar-nav li').forEach(li => {
        const text = (li.textContent || '').toLowerCase();
        li.hidden = q.length > 0 && !text.includes(q);
      });
      document.querySelectorAll<HTMLDetailsElement>('.sidebar-nav details').forEach(d => {
        // 没有可见项的 subsection-label 隐藏
        d.querySelectorAll<HTMLElement>('.subsection-label').forEach(label => {
          const next = label.nextElementSibling as HTMLElement | null;
          if (next && next.tagName === 'UL') {
            const hasVisible = Array.from(next.querySelectorAll('li')).some(li => !li.hidden);
            label.hidden = !hasVisible;
          }
        });
        if (q.length > 0) {
          // 过滤模式：所有有匹配项的 section 都展开
          const visibleCount = d.querySelectorAll('li:not([hidden])').length;
          d.open = visibleCount > 0;
        } else {
          // 清空：恢复 SSR 初始状态
          d.open = initialOpenState.get(d.dataset.section || '') ?? false;
        }
      });
    };
    search.addEventListener('input', applyFilter);
    search.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        search.value = '';
        applyFilter();
        search.blur();
      }
    });
  }
</script>
