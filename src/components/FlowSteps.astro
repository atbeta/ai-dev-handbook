---
export interface FlowStep {
  title: string;
  sub?: string;
  tag?: string;
}

interface Props {
  steps: FlowStep[];
  layout?: 'horizontal' | 'vertical';
  caption?: string;
}

const { steps, layout = 'horizontal', caption } = Astro.props;
---

<figure class={`flow-steps flow-${layout}`} role="group" aria-label={caption ?? '流程步骤'}>
  {caption && <figcaption class="flow-caption">{caption}</figcaption>}
  <ol class="flow-list">
    {steps.map((step, i) => (
      <li class="flow-item">
        <div class="flow-card">
          <span class="flow-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="flow-body">
            <strong class="flow-title">{step.title}</strong>
            {step.sub && <span class="flow-sub">{step.sub}</span>}
            {step.tag && <span class="flow-tag">{step.tag}</span>}
          </div>
        </div>
        {i < steps.length - 1 && (
          <span class="flow-arrow" aria-hidden="true">
            {layout === 'vertical' ? '↓' : '→'}
          </span>
        )}
      </li>
    ))}
  </ol>
</figure>

<style>
  .flow-steps {
    margin: 20px 0 28px;
    padding: 0;
    border: none;
  }
  .flow-caption {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-muted);
    margin-bottom: 12px;
    letter-spacing: 0.3px;
  }
  .flow-caption::before { content: '# '; color: var(--c-accent); }

  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
  }

  .flow-vertical .flow-list {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .flow-item {
    display: flex;
    align-items: center;
    flex: 0 1 auto;
  }
  .flow-vertical .flow-item {
    flex-direction: column;
    align-items: stretch;
  }

  .flow-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, box-shadow 0.2s;
    min-width: 0;
  }
  .flow-card:hover {
    border-color: var(--c-border-strong);
    box-shadow: var(--shadow-md);
  }

  .flow-horizontal .flow-card {
    min-width: 120px;
    max-width: 200px;
  }
  .flow-vertical .flow-card {
    width: 100%;
    max-width: 520px;
  }

  .flow-num {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--c-accent);
    background: var(--c-accent-bg);
    padding: 2px 7px;
    border-radius: 4px;
    line-height: 1.4;
  }

  .flow-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .flow-title {
    font-size: 0.92rem;
    color: var(--c-text);
    line-height: 1.35;
  }
  .flow-sub {
    font-size: 0.78rem;
    color: var(--c-text-muted);
    line-height: 1.4;
  }
  .flow-tag {
    display: inline-block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--c-text-secondary);
    background: var(--c-bg-tertiary);
    border: 1px solid var(--c-border);
    padding: 1px 6px;
    border-radius: 3px;
    width: fit-content;
  }

  .flow-arrow {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--c-text-muted);
    padding: 0 8px;
    user-select: none;
  }
  .flow-vertical .flow-arrow {
    padding: 4px 0 4px 18px;
    align-self: flex-start;
  }

  @media (max-width: 640px) {
    .flow-horizontal .flow-list {
      flex-direction: column;
      align-items: stretch;
    }
    .flow-horizontal .flow-item {
      flex-direction: column;
      align-items: stretch;
    }
    .flow-horizontal .flow-card {
      max-width: none;
    }
    .flow-horizontal .flow-arrow {
      padding: 4px 0 4px 18px;
      align-self: flex-start;
    }
  }
</style>
