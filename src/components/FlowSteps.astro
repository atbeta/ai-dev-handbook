---
export interface FlowStep {
  title: string;
  sub?: string;
  tag?: string;
}

interface Props {
  steps: FlowStep[];
  layout?: 'horizontal' | 'vertical';
  caption?: string;
}

const { steps, layout = 'horizontal', caption } = Astro.props;
---

<figure class={`flow-steps flow-${layout}`} role="group" aria-label={caption ?? '流程步骤'}>
  {caption && <figcaption class="flow-caption">{caption}</figcaption>}
  <ol class="flow-list">
    {steps.map((step, i) => (
      <li class="flow-item">
        <div class="flow-rail" aria-hidden="true">
          <span class="flow-node">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <div class="flow-card">
          <div class="flow-body">
            <span class="flow-hnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <strong class="flow-title">{step.title}</strong>
            {step.sub && <span class="flow-sub">{step.sub}</span>}
          </div>
          {step.tag && <span class="flow-tag">{step.tag}</span>}
        </div>
        {layout === 'horizontal' && i < steps.length - 1 && (
          <span class="flow-arrow" aria-hidden="true">→</span>
        )}
      </li>
    ))}
  </ol>
</figure>

<style>
  .flow-steps {
    margin: 20px 0 28px;
    padding: 0;
    border: none;
  }
  .flow-caption {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-muted);
    margin-bottom: 16px;
    letter-spacing: 0.3px;
  }
  .flow-caption::before { content: '# '; color: var(--c-accent); }

  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ===== Vertical: timeline with connecting spine ===== */
  .flow-vertical .flow-list {
    display: flex;
    flex-direction: column;
  }
  .flow-vertical .flow-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    position: relative;
    padding-bottom: 14px;
  }
  .flow-vertical .flow-item:last-child { padding-bottom: 0; }

  .flow-vertical .flow-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }
  /* connecting line from this node down to the next */
  .flow-vertical .flow-item:not(:last-child) .flow-rail::after {
    content: '';
    position: absolute;
    top: 36px;
    bottom: -14px;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, var(--c-border-strong), var(--c-border));
  }

  .flow-node {
    z-index: 1;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-accent);
    background: var(--c-bg);
    border: 1.5px solid var(--c-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--c-bg), 0 0 10px var(--c-accent-bg);
  }

  /* ===== Horizontal: cards with arrows ===== */
  .flow-horizontal .flow-list {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 8px 0;
  }
  .flow-horizontal .flow-item {
    display: flex;
    align-items: stretch;
    flex: 1 1 0;
    min-width: 130px;
  }
  .flow-horizontal .flow-rail {
    display: none;
  }
  .flow-horizontal .flow-card {
    flex: 1;
    flex-direction: column;
  }
  .flow-horizontal .flow-node { display: none; }

  /* ===== Shared card ===== */
  .flow-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 15px;
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    min-width: 0;
  }
  .flow-vertical .flow-card { flex: 1; }
  .flow-card:hover {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .flow-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  /* number chip shown only in horizontal cards (vertical uses rail node) */
  .flow-hnum {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-accent);
    background: var(--c-accent-bg);
    padding: 1px 6px;
    border-radius: 3px;
    width: fit-content;
  }
  .flow-horizontal .flow-hnum { display: inline-block; }
  .flow-title {
    font-size: 0.95rem;
    color: var(--c-text);
    line-height: 1.35;
  }
  .flow-sub {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    line-height: 1.45;
  }
  .flow-tag {
    flex-shrink: 0;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--c-accent);
    background: var(--c-accent-bg);
    padding: 2px 7px;
    border-radius: 3px;
  }
  .flow-horizontal .flow-tag { margin-top: 4px; }

  .flow-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--c-accent);
    padding: 0 6px;
    user-select: none;
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .flow-horizontal .flow-list {
      flex-direction: column;
    }
    .flow-horizontal .flow-item {
      flex-direction: column;
      min-width: 0;
    }
    .flow-horizontal .flow-arrow {
      justify-content: flex-start;
      padding: 4px 0 4px 20px;
      transform: rotate(90deg);
      transform-origin: left center;
    }
  }
</style>
