---
export interface StatItem {
  label: string;
  value: number;
  display?: string;
  note?: string;
  tier?: 'low' | 'mid' | 'high' | 'sat';
  highlight?: boolean;
}

export interface ThresholdLine {
  value: number;
  label: string;
  kind?: 'observe' | 'warn';
}

interface Props {
  items: StatItem[];
  caption?: string;
  max?: number;
  thresholds?: ThresholdLine[];
  unit?: string;
}

const { items, caption, max = 100, thresholds = [], unit = '%' } = Astro.props;

const tierColor = (tier?: StatItem['tier']) => {
  switch (tier) {
    case 'sat': return 'var(--c-green)';
    case 'low': return 'var(--c-green)';
    case 'mid': return 'var(--c-orange)';
    case 'high': return 'var(--c-red)';
    default: return 'var(--c-accent)';
  }
};
---

<figure class="stat-chart" role="img" aria-label={caption ?? '数据对比图'}>
  {caption && <figcaption class="stat-caption">{caption}</figcaption>}
  <div class="stat-bars">
    {items.map((item) => {
      const pct = Math.min(100, Math.max(0, (item.value / max) * 100));
      const color = item.highlight ? 'var(--c-accent)' : tierColor(item.tier);
      return (
        <div class={`stat-row ${item.highlight ? 'stat-highlight' : ''}`}>
          <div class="stat-meta">
            <span class="stat-label">{item.label}</span>
            {item.note && <span class="stat-note">{item.note}</span>}
          </div>
          <div class="stat-track" aria-hidden="true">
            {thresholds.map((t) => (
              <span
                class={`stat-threshold stat-threshold-${t.kind ?? 'observe'}`}
                style={`left: ${(t.value / max) * 100}%`}
                title={t.label}
              />
            ))}
            <span
              class="stat-fill"
              style={`width: ${pct}%; background: ${color}`}
            />
          </div>
          <span class="stat-value">{item.display ?? `${item.value}${unit}`}</span>
        </div>
      );
    })}
  </div>
  {thresholds.length > 0 && (
    <div class="stat-legend" aria-hidden="true">
      {thresholds.map((t) => (
        <span class={`legend-item legend-${t.kind ?? 'observe'}`}>{t.label}</span>
      ))}
    </div>
  )}
</figure>

<style>
  .stat-chart {
    margin: 20px 0 28px;
    padding: 16px 18px;
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
  }
  .stat-caption {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-muted);
    margin-bottom: 16px;
    letter-spacing: 0.3px;
  }
  .stat-caption::before { content: '# '; color: var(--c-accent); }

  .stat-bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .stat-row {
    display: grid;
    grid-template-columns: minmax(140px, 1.2fr) 1fr auto;
    gap: 12px;
    align-items: center;
  }
  .stat-highlight .stat-label { color: var(--c-accent); font-weight: 600; }

  .stat-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .stat-label {
    font-size: 0.88rem;
    color: var(--c-text);
    line-height: 1.3;
  }
  .stat-note {
    font-size: 0.72rem;
    color: var(--c-text-muted);
    line-height: 1.3;
  }

  .stat-track {
    position: relative;
    height: 10px;
    background: var(--c-bg-tertiary);
    border: 1px solid var(--c-border);
    border-radius: 4px;
    overflow: visible;
  }
  .stat-fill {
    display: block;
    height: 100%;
    border-radius: 3px;
    min-width: 2px;
    transition: width 0.3s ease;
    opacity: 0.85;
  }
  .stat-highlight .stat-fill { opacity: 1; box-shadow: 0 0 8px var(--c-accent-bg); }

  .stat-threshold {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    transform: translateX(-50%);
    z-index: 1;
    border-radius: 1px;
  }
  .stat-threshold-observe {
    background: var(--c-orange);
    opacity: 0.7;
  }
  .stat-threshold-warn {
    background: var(--c-red);
    opacity: 0.85;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-text-secondary);
    white-space: nowrap;
    min-width: 52px;
    text-align: right;
  }
  .stat-highlight .stat-value { color: var(--c-accent); }

  .stat-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed var(--c-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--c-text-muted);
  }
  .legend-item::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 2px;
    margin-right: 6px;
    vertical-align: middle;
    border-radius: 1px;
  }
  .legend-observe::before { background: var(--c-orange); }
  .legend-warn::before { background: var(--c-red); }

  @media (max-width: 600px) {
    .stat-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .stat-value { text-align: left; }
  }
</style>
