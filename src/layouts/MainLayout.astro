---
import 'prismjs/themes/prism-tomorrow.css';

const { title, description, showSidebar = true, showToc = true, class: className } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{Astro.props.title || 'AI 生产级开发指南'}</title>
    <meta name="description" content={Astro.props.description || 'AI 辅助生产级软件开发的完整指南：调研、实践、工具、案例'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
      
      document.addEventListener('DOMContentLoaded', () => {
        const handleToggleClick = () => {
          const element = document.documentElement;
          element.classList.toggle("dark");
          const isDark = element.classList.contains("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        };
        const btn = document.getElementById("theme-toggle");
        if (btn) btn.addEventListener("click", handleToggleClick);
      });
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <span class="logo-icon">⚙️</span>
          <span class="logo-text">AI Dev Handbook</span>
        </a>
        <nav class="main-nav" aria-label="主导航">
          <a href="/research/landscape" class={Astro.url.pathname.startsWith('/research') ? 'active' : ''}>调研</a>
          <a href="/handbook/why" class={Astro.url.pathname.startsWith('/handbook') ? 'active' : ''}>实践指南</a>
          <a href="/strategy/pilot-playbook" class={Astro.url.pathname.startsWith('/strategy') ? 'active' : ''}>组织推广</a>
          <a href="/templates/spec" class={Astro.url.pathname.startsWith('/templates') ? 'active' : ''}>模板</a>
          <a href="/about" class={Astro.url.pathname === '/about' ? 'active' : ''}>关于</a>
          
          <div class="nav-divider"></div>
          
          <button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <div class={`page-wrapper ${className || ""}`}>
      {Astro.props.showSidebar !== false && (
        <aside class="sidebar" id="sidebar">
          <nav class="sidebar-nav" aria-label="侧边栏导航">
            <slot name="sidebar" />
          </nav>
        </aside>
      )}
      <main class="main-content">
        <article class="content">
          <slot />
        </article>
      </main>
      {Astro.props.showToc !== false && (
        <aside class="toc-sidebar">
          <nav class="toc-nav" aria-label="页面目录">
            <div class="toc-title">本页目录</div>
            <div class="toc-list" id="toc-list"></div>
          </nav>
        </aside>
      )}
    </div>

    <footer class="site-footer">
      <div class="container">
        <p>AI Dev Handbook — 让 AI 辅助开发走上工程化轨道</p>
        <p class="footer-meta">v2.8 · 2026-07 · <a href="https://github.com/atbeta/ai-dev-handbook">GitHub</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Light Mode */
    --c-bg: #ffffff;
    --c-bg-secondary: #f6f8fa;
    --c-header-bg: rgba(246, 248, 250, 0.8);
    --c-bg-tertiary: #f3f4f6;
    --c-border: #d0d7de;
    --c-border-strong: #afb8c1;
    --c-divider: rgba(31, 35, 40, 0.08);
    --c-text: #1f2328;
    --c-text-secondary: #656d76;
    --c-text-muted: #8c959f;
    --c-accent: #0969da;
    --c-accent-dim: #0550ae;
    --c-accent-bg: rgba(9, 105, 218, 0.08);
    --c-green: #1a7f37;
    --c-orange: #9a6700;
    --c-red: #d1242f;
    --c-purple: #8250df;
    
    --shadow-sm: 0 1px 2px rgba(31, 35, 40, 0.04);
    --shadow-md: 0 3px 6px rgba(31, 35, 40, 0.06), 0 1px 2px rgba(31, 35, 40, 0.04);
    
    --bg-grid: linear-gradient(to right, rgba(31, 35, 40, 0.03) 1px, transparent 1px),
               linear-gradient(to bottom, rgba(31, 35, 40, 0.03) 1px, transparent 1px);
               
    --font-mono: 'SF Mono', 'Fira Code', 'Fira Mono', Menlo, Consolas, monospace;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', sans-serif;
    --max-width: 1320px;
    --sidebar-width: 260px;
    --toc-width: 220px;
    --header-height: 56px;
  }

  html.dark {
    /* Dark Mode */
    --c-bg: #0d1117;
    --c-bg-secondary: #161b22;
    --c-header-bg: rgba(22, 27, 34, 0.8);
    --c-bg-tertiary: #1c2128;
    --c-border: #30363d;
    --c-border-strong: #484f58;
    --c-divider: rgba(240, 246, 252, 0.08);
    --c-text: #e6edf3;
    --c-text-secondary: #8b949e;
    --c-text-muted: #6e7681;
    --c-accent: #58a6ff;
    --c-accent-dim: #1f6feb;
    --c-accent-bg: rgba(88, 166, 255, 0.1);
    --c-green: #3fb950;
    --c-orange: #d29922;
    --c-red: #f85149;
    --c-purple: #a371f7;
    
    --shadow-sm: 0 1px 2px rgba(1, 4, 9, 0.8);
    --shadow-md: 0 3px 6px rgba(1, 4, 9, 0.8), 0 1px 2px rgba(1, 4, 9, 0.8);
    
    --bg-grid: linear-gradient(to right, rgba(31, 35, 40, 0.03) 1px, transparent 1px),
               linear-gradient(to bottom, rgba(31, 35, 40, 0.03) 1px, transparent 1px);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--c-text);
    background: var(--c-bg);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-image: var(--bg-grid);
    background-size: 24px 24px;
    background-attachment: fixed;
  }

  a {
    color: var(--c-accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  a:hover { text-decoration: underline; }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-header-bg);
    border-bottom: 1px solid var(--c-divider);
    height: var(--header-height);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm);
  }
  
  .site-header .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--c-text);
    text-decoration: none;
  }
  .logo-icon { font-size: 1.3rem; }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .main-nav a {
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--c-text-secondary);
    transition: all 0.15s;
    font-weight: 500;
  }
  .main-nav a:hover,
  .main-nav a.active {
    color: var(--c-text);
    background: var(--c-bg-tertiary);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }
  
  .nav-divider {
    width: 1px;
    height: 16px;
    background: var(--c-border);
    margin: 0 8px;
  }
  
  .theme-toggle {
    background: transparent;
    border: none;
    color: var(--c-text-secondary);
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }
  .theme-toggle:hover {
    color: var(--c-text);
    background: var(--c-bg-tertiary);
  }
  html.dark .sun-icon { display: block; }
  html.dark .moon-icon { display: none; }
  html:not(.dark) .sun-icon { display: none; }
  html:not(.dark) .moon-icon { display: block; }

  /* Page wrapper */
  .page-wrapper {
    flex: 1;
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    background: var(--c-bg);
    box-shadow: none;
  }

  /* Sidebar */
  .sidebar {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    padding: 0 14px 24px 20px;
    border-right: 1px solid var(--c-divider);
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    overflow-x: hidden;
    background: var(--c-bg);
    scrollbar-width: none;
  }
  .sidebar::-webkit-scrollbar { width: 0; height: 0; }

  .sidebar-nav {
    font-size: 0.86rem;
    padding-top: 16px;
  }

  .sidebar-search {
    display: block;
    width: 100%;
    margin: 0 0 16px;
    padding: 8px 12px;
    font-size: 0.82rem;
    color: var(--c-text);
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 6px;
    outline: none;
    transition: all 0.2s;
    position: sticky;
    top: 0;
    z-index: 2;
    box-shadow: var(--shadow-sm);
  }
  .sidebar-search::placeholder { color: var(--c-text-muted); }
  .sidebar-search:focus {
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px var(--c-accent-bg);
  }

  /* Section details */
  .summary-icon {
    color: var(--c-text-muted);
    transition: color 0.15s;
    margin-right: 6px;
  }
  .sidebar-nav details[data-active="true"] > summary .summary-icon {
    color: var(--c-accent);
  }
  .sidebar-nav details { margin-bottom: 6px; }
  .sidebar-nav summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    border-radius: 6px;
    cursor: pointer;
    color: var(--c-text);
    font-weight: 600;
    font-size: 0.86rem;
    list-style: none;
    user-select: none;
    transition: background 0.12s, color 0.12s;
  }
  .sidebar-nav summary::-webkit-details-marker { display: none; }
  .sidebar-nav summary::marker { display: none; }
  .summary-left {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .arrow {
    display: inline-block;
    width: 12px;
    height: 12px;
    position: relative;
    flex-shrink: 0;
    transition: transform 0.15s;
  }
  .arrow::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    border-left: 4px solid var(--c-text-muted);
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    transform: translate(-50%, -50%);
  }
  .sidebar-nav details[open] > summary > .summary-left > .arrow {
    transform: rotate(90deg);
  }
  .sidebar-nav summary:hover { background: var(--c-bg-tertiary); }
  .sidebar-nav details[data-active="true"] > summary {
    color: var(--c-accent);
    background: var(--c-accent-bg);
  }
  .sidebar-nav details[data-active="true"] > summary .arrow::before {
    border-left-color: var(--c-accent);
  }

  .subsection-label {
    font-size: 0.75rem;
    color: var(--c-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 8px 4px 18px;
    font-weight: 700;
  }
  
  .sidebar-nav ul {
    list-style: none;
    padding-left: 10px;
    margin: 0 0 4px;
    margin-left: 14px;
  }
  .sidebar-nav li a {
    display: block;
    padding: 6px 12px;
    border-radius: 6px;
    color: var(--c-text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
    transition: all 0.15s;
    position: relative;
  }
  .sidebar-nav li a:hover {
    color: var(--c-text);
    background: var(--c-bg-tertiary);
    text-decoration: none;
  }
  .sidebar-nav li a.active {
    color: var(--c-accent);
    background: var(--c-accent-bg);
    font-weight: 600;
  }

  /* Main Content */
  .main-content {
    flex: 1;
    min-width: 0;
    padding: 40px 56px 80px;
    max-width: calc(100% - var(--sidebar-width) - var(--toc-width));
  }
  .page-wrapper.index-layout .main-content {
    max-width: 960px;
    margin: 0 auto;
  }
  .content {
    max-width: 840px; /* Optimal reading width */
    margin: 0 auto;
  }
  .page-wrapper.index-layout .content {
    max-width: 100%;
  }

  /* Typography */
  .content h1 {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 12px;
    letter-spacing: -0.5px;
    line-height: 1.2;
    color: var(--c-text);
  }
  .content h2 {
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 48px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--c-divider);
  }
  .content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .content p { margin-bottom: 16px; font-size: 1rem; color: var(--c-text); }
  .content ul, .content ol { margin-bottom: 16px; padding-left: 24px; }
  .content li { margin-bottom: 8px; }
  
  .content blockquote {
    border-left: 4px solid var(--c-accent);
    padding: 16px 20px;
    margin: 24px 0;
    background: var(--c-bg-secondary);
    border-radius: 0 8px 8px 0;
    color: var(--c-text-secondary);
    font-size: 0.95rem;
    box-shadow: var(--shadow-sm);
  }
  .content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--c-bg-secondary);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    border: 1px solid var(--c-border);
    color: var(--c-text);
  }
  .content pre {
    margin: 24px 0;
    border-radius: 8px;
    border: 1px solid var(--c-border);
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
    background: var(--c-bg-secondary) !important; /* fallback */
  }
  .content pre code {
    background: none;
    border: none;
    padding: 20px;
    display: block;
    font-size: 0.85rem;
    line-height: 1.6;
    color: inherit;
  }
  
  /* Theming shiki based on HTML class */
  html.dark .shiki,
  html.dark .shiki span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 0.9rem;
    box-shadow: var(--shadow-sm);
    border-radius: 8px;
    overflow: hidden;
  }
  .content th, .content td {
    padding: 12px 16px;
    text-align: left;
    border: 1px solid var(--c-border);
  }
  .content th {
    background: var(--c-bg-secondary);
    font-weight: 600;
  }
  .content tr:nth-child(even) { background: var(--c-bg-secondary); }
  .content hr {
    border: none;
    border-top: 1px solid var(--c-border);
    margin: 40px 0;
  }
  .content img {
    max-width: 100%;
    border-radius: 8px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--c-border);
  }

  /* Admonitions */
  .admonition {
    border-left: 4px solid;
    padding: 16px 20px;
    margin: 24px 0;
    border-radius: 0 8px 8px 0;
    font-size: 0.95rem;
    box-shadow: var(--shadow-sm);
  }
  .admonition.tip { border-color: var(--c-green); background: rgba(26, 127, 55, 0.05); }
  .admonition.warning { border-color: var(--c-orange); background: rgba(154, 103, 0, 0.05); }
  .admonition.danger { border-color: var(--c-red); background: rgba(209, 36, 47, 0.05); }
  .admonition.info { border-color: var(--c-accent); background: var(--c-accent-bg); }
  html.dark .admonition.tip { background: rgba(63, 185, 80, 0.08); }
  html.dark .admonition.warning { background: rgba(210, 153, 34, 0.08); }
  html.dark .admonition.danger { background: rgba(248, 81, 73, 0.08); }
  
  .admonition-title {
    font-weight: 700;
    margin-bottom: 6px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Cards */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin: 24px 0;
  }
  .card {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    padding: 20px;
    transition: all 0.2s;
    box-shadow: var(--shadow-sm);
  }
  .card:hover { 
    border-color: var(--c-accent); 
    box-shadow: var(--shadow-md), 0 0 0 1px var(--c-accent);
    transform: translateY(-2px);
  }

  /* TOC sidebar */
  .toc-sidebar {
    width: var(--toc-width);
    min-width: var(--toc-width);
    padding: 32px 18px 32px 18px;
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    border-left: 1px solid var(--c-divider);
    font-size: 0.82rem;
    background: var(--c-bg);
    scrollbar-width: none;
  }
  .toc-sidebar::-webkit-scrollbar { width: 0; height: 0; }
  .toc-title {
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--c-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.75rem;
  }
  .toc-list a {
    display: block;
    padding: 5px 10px;
    border-radius: 4px;
    color: var(--c-text-secondary);
    transition: all 0.15s;
    margin-bottom: 2px;
  }
  .toc-list a:hover,
  .toc-list a.active {
    color: var(--c-text);
    background: var(--c-bg-tertiary);
    text-decoration: none;
  }

  /* Utility */
  .container { max-width: var(--max-width); margin: 0 auto; padding: 0 24px; }
  .tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    background: var(--c-bg-tertiary);
    color: var(--c-text);
    border: 1px solid var(--c-border);
    margin-right: 6px;
    font-family: var(--font-mono);
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--c-border);
    padding: 32px 24px;
    text-align: center;
    color: var(--c-text-secondary);
    font-size: 0.85rem;
    background: var(--c-bg-secondary);
  }
  .site-footer p { margin-bottom: 8px; }
  
  @media (max-width: 1200px) {
    .toc-sidebar { display: none; }
    .main-content { max-width: calc(100% - var(--sidebar-width)); padding: 32px 40px 64px; }
  }
  @media (max-width: 768px) {
    .sidebar { display: none; }
    .main-content { max-width: 100%; padding: 24px 20px 48px; }
  }
</style>

<script is:inline>
  // Auto-generate TOC from h2/h3 headings
  document.addEventListener('DOMContentLoaded', () => {
    const tocList = document.getElementById('toc-list');
    if (!tocList) return;
    const headings = document.querySelectorAll('.content h2, .content h3');
    headings.forEach(h => {
      if (!h.id) {
        h.id = h.textContent.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-').replace(/(^-|-$)/g, '');
      }
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent;
      a.style.paddingLeft = h.tagName === 'H3' ? '20px' : '0';
      a.style.fontSize = h.tagName === 'H3' ? '0.8rem' : '0.82rem';
      tocList.appendChild(a);
    });

    // Highlight active TOC item on scroll
    const tocLinks = tocList.querySelectorAll('a');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocLinks.forEach(a => a.classList.remove('active'));
          const link = tocList.querySelector(`a[href="#${entry.target.id}"]`);
          if (link) link.classList.add('active');
        }
      });
    }, { rootMargin: '-80px 0px -80% 0px' });
    headings.forEach(h => observer.observe(h));
  });
</script>
