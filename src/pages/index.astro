---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  class="index-layout"
  title="AI Dev Handbook // ai-dev.pbeta.dev"
  description="AI 辅助生产级软件开发的工程化方法论：理论有调研，实践有 SOP"
  showSidebar={false}
  showToc={false}
>
  <!-- Status bar -->
  <div class="statusbar">
    <span class="sb-item sb-dot sb-green"></span>
    <span class="sb-item">~/projects/ai-dev-handbook</span>
    <span class="sb-item sb-sep">·</span>
    <span class="sb-item">v2.9</span>
    <span class="sb-item sb-sep">·</span>
    <span class="sb-item">54 pages</span>
    <span class="sb-item sb-sep">·</span>
    <span class="sb-item">last commit: 2026-07-14</span>
  </div>

  <!-- Terminal hero -->
  <section class="terminal-hero">
    <div class="terminal-header">
      <span class="term-dot term-red"></span>
      <span class="term-dot term-yellow"></span>
      <span class="term-dot term-green"></span>
      <span class="term-title">ai-dev-handbook — bash — 120×40</span>
    </div>
    <div class="terminal-body">
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">cat ./README.md | head</span>
      </div>
      <pre class="ascii-art">{`
    _   ___   ____  _____   __  
   /_\ |_ _| |  _ \| __\ \ / /  
  / _ \ | |  | | | |  | \ V /   
 / ___ \| |  | |_| | |__ \ /    
/_/   \_\___||____/|____| \_/   
                                
      Dev Handbook · v2.9 · 54 pages
`}</pre>
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">echo "AI 辅助生产级开发的工程化方法论"</span>
      </div>
      <div class="term-line term-output">
        AI 辅助生产级开发的工程化方法论
      </div>
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">./start.sh</span>
      </div>
      <div class="term-output">
        <div class="term-log">[<span class="log-ok">✓</span>] research/       loaded (industry signals + cases)</div>
        <div class="term-log">[<span class="log-ok">✓</span>] handbook/       loaded (methods + scenarios)</div>
        <div class="term-log">[<span class="log-ok">✓</span>] strategy/       loaded (pilot playbook + lessons)</div>
        <div class="term-log">[<span class="log-ok">✓</span>] templates/      loaded (9 reusable templates)</div>
        <div class="term-log term-em">[<span class="log-ok">→</span>] ready. navigate: <a href="#pipeline">delivery pipeline</a></div>
      </div>
    </div>
  </section>

  <!-- Production delivery pipeline: the spine of the whole site -->
  <section class="section" id="pipeline">
    <h2 class="sec-h2"><span class="sec-bracket">[</span> delivery-pipeline --stages=7 <span class="sec-bracket">]</span></h2>
    <p class="pipeline-lead">
      一个目标：<strong>用 AI 辅助把生产级项目做出来、交付上线、长期维护</strong>。
      下面这条主线把全站内容串成一条从需求到运维的交付链路——人负责判断与验收，AI 负责放大执行。带
      <span class="stage-todo">待补</span> 的环节是已规划、内容尚未补齐的部分。
    </p>
    <div class="pipeline">
      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">01</span>
          <div class="stage-title">
            <strong>判断与边界</strong>
            <span class="stage-sub">先想清楚哪些该交给 AI、哪些必须人来扛</span>
          </div>
        </div>
        <div class="stage-links">
          <a href="/research/landscape">行业全景图</a>
          <a href="/research/ai-boundaries">AI 能力边界</a>
          <a href="/research/vibe-vs-spec">Vibe vs Spec</a>
          <a href="/research/hard-data">硬数据与事故</a>
          <a href="/research/full-stack-trend-2026">全栈化趋势</a>
        </div>
      </div>

      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">02</span>
          <div class="stage-title">
            <strong>Spec 工程化</strong>
            <span class="stage-sub">把模糊需求写成可验证的合同，供给正确上下文</span>
          </div>
        </div>
        <div class="stage-links">
          <a href="/handbook/why">为什么需要这套流程</a>
          <a href="/handbook/workflow">6 步工作流</a>
          <a href="/handbook/spec-format">Spec 字段规范</a>
          <a href="/handbook/clarification">澄清循环</a>
          <a href="/handbook/lint-protocol">AI Lint 协议</a>
          <a href="/handbook/context-engineering">上下文工程</a>
        </div>
      </div>

      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">03</span>
          <div class="stage-title">
            <strong>协作与分工</strong>
            <span class="stage-sub">定义人机边界、契约与多角色协作方式</span>
          </div>
        </div>
        <div class="stage-links">
          <a href="/handbook/contract-first">契约优先分工</a>
          <a href="/handbook/constitution">Constitution 模式</a>
          <a href="/handbook/team-roles">团队角色与协作</a>
          <a href="/handbook/why-spec-driven-dev">Spec-Driven-Dev 定位</a>
          <a href="/research/openspec-in-production">OpenSpec 生产调优</a>
        </div>
      </div>

      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">04</span>
          <div class="stage-title">
            <strong>场景执行</strong>
            <span class="stage-sub">在真实项目里落地：第一单、陌生代码库、并行与异步</span>
          </div>
        </div>
        <div class="stage-links">
          <a href="/handbook/first-task-sop">第一单 SOP</a>
          <a href="/handbook/unfamiliar-codebase">陌生代码库协作</a>
          <a href="/handbook/parallel-sessions">多 AI 会话并行</a>
          <a href="/handbook/async-nightly">夜间异步执行</a>
        </div>
      </div>

      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">05</span>
          <div class="stage-title">
            <strong>质量门与验收</strong>
            <span class="stage-sub">交付前的硬约束：质量门、反模式、失败复盘</span>
          </div>
        </div>
        <div class="stage-links">
          <a href="/handbook/quality-gate">质量门工具</a>
          <a href="/handbook/anti-patterns">反模式与失败模式</a>
          <a href="/handbook/lessons">项目交付教训</a>
          <a href="/templates/checklist">流程 Checklist</a>
        </div>
      </div>

      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">06</span>
          <div class="stage-title">
            <strong>发布与运维</strong>
            <span class="stage-sub">上线、回滚、事故复盘与文档同步——生产级的后半程</span>
          </div>
        </div>
        <div class="stage-links">
          <a href="/handbook/docs-sync-strategy">文档同步策略</a>
          <a href="/handbook/release-rollback">发布与回滚预案</a>
          <a href="/handbook/incident-postmortem">事故复盘与 AI 协作</a>
        </div>
      </div>

      <div class="stage">
        <div class="stage-head">
          <span class="stage-num">07</span>
          <div class="stage-title">
            <strong>组织推广与持续追踪</strong>
            <span class="stage-sub">从试点到长期机制，并持续追踪工具与行业变化</span>
          </div>
        </div>
        <div class="stage-links">
          <a href="/strategy/pilot-playbook">试点负责人 Playbook</a>
          <a href="/strategy/pilot-lessons">试点复盘案例</a>
          <a href="/handbook/full-stack-team-model">全员全栈团队模式</a>
          <a href="/research/transformation">团队转型路线图</a>
          <a href="/handbook/tool-stack">工具体系地图</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Core beliefs behind the pipeline -->
  <section class="section">
    <h2 class="sec-h2"><span class="sec-bracket">[</span> core-beliefs --top=8 <span class="sec-bracket">]</span></h2>
    <p class="pipeline-lead">支撑上面这条主线的 8 条核心判断——它们解释了每个环节「为什么必须这么做」。</p>
    <div class="insights-grid">
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">01</span>
          <span class="ic-tag">core</span>
        </div>
        <div class="ic-body">
          <strong>AI 是放大器，不是工程师。</strong>
          <p>输入模糊 → 快速产出模糊。输入清晰 → 高效产出正确。Spec 是流程中唯一可由人完全控制的变量。</p>
        </div>
      </div>
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">02</span>
          <span class="ic-tag">core</span>
        </div>
        <div class="ic-body">
          <strong>Vibe 和 Spec 不是二选一。</strong>
          <p>原型探索用 vibe，生产交付用 spec。区分场景比争论方法更重要。</p>
        </div>
      </div>
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">03</span>
          <span class="ic-tag">practice</span>
        </div>
        <div class="ic-body">
          <strong>生产级任务要把大量时间花在 Spec 上。</strong>
          <p>复杂业务和迁移任务里，前期澄清、示例和验收条件通常决定后续返工率；比例应按团队数据持续校准。</p>
        </div>
      </div>
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">04</span>
          <span class="ic-tag">core</span>
        </div>
        <div class="ic-body">
          <strong>上下文工程正在成为关键能力。</strong>
          <p>给 AI 提供什么上下文（AGENTS.md、Repo Map、MCP），比 prompt 本身更能决定代码质量。</p>
        </div>
      </div>
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">05</span>
          <span class="ic-tag">signal</span>
        </div>
        <div class="ic-body">
          <strong>AI 代码长期维护成本容易被低估。</strong>
          <p>代码 churn、重复率、review 拦截率都应纳入质量门监控。AI 让写代码变快，review 不应缩水。</p>
        </div>
      </div>
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">06</span>
          <span class="ic-tag">scout</span>
        </div>
        <div class="ic-body">
          <strong>陌生代码库：先建心智地图，再引入 AI。</strong>
          <p>人先完成 2-4 小时的结构理解，AI 才能作为代码侦察和执行工具。三阶段渐进信任：考古 → 侦察 → 协作。</p>
        </div>
      </div>
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">07</span>
          <span class="ic-tag">flow</span>
        </div>
        <div class="ic-body">
          <strong>Files ARE the State。</strong>
          <p>离开电脑前最后 1 分钟，把判断写到 TASK_STATE.md。第二天靠文件接续，减少重新对齐成本。</p>
        </div>
      </div>
      <div class="insight-card">
        <div class="ic-header">
          <span class="ic-num">08</span>
          <span class="ic-tag">infra</span>
        </div>
        <div class="ic-body">
          <strong>公司 AI 基础设施决定团队上限。</strong>
          <p>并行数量瓶颈是 TPS 配额，不是 session 本身。同步对话独占 TPS、异步任务高并发、评审必须强模型。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reading paths as CLI -->
  <section class="section" id="paths">
    <h2 class="sec-h2"><span class="sec-bracket">[</span> ./read --role=&lt;who&gt; <span class="sec-bracket">]</span></h2>
    <div class="paths">
      <div class="path">
        <div class="path-prompt"><span class="term-prompt">$</span> ./read --role=pilot-lead</div>
        <div class="path-flow">
          <a href="/strategy/pilot-playbook">试点负责人 Playbook</a>
          <span class="arr">→</span>
          <a href="/research/hard-data">硬数据与事故</a>
          <span class="arr">→</span>
          <a href="/handbook/ai-as-amplifier">AI 是放大器</a>
          <span class="arr">→</span>
          <a href="/handbook/first-task-sop">第一单 SOP</a>
          <span class="arr">→</span>
          <a href="/handbook/anti-patterns">反模式</a>
        </div>
        <div class="path-tag"># 试点负责人</div>
      </div>

      <div class="path">
        <div class="path-prompt"><span class="term-prompt">$</span> ./read --role=engineer</div>
        <div class="path-flow">
          <a href="/handbook/ai-as-amplifier">AI 是放大器</a>
          <span class="arr">→</span>
          <a href="/research/ai-boundaries">AI 能力边界</a>
          <span class="arr">→</span>
          <a href="/handbook/first-task-sop">第一单 SOP</a>
          <span class="arr">→</span>
          <a href="/handbook/spec-format">Spec 字段规范</a>
          <span class="arr">→</span>
          <a href="/handbook/anti-patterns">反模式</a>
        </div>
        <div class="path-tag"># 工程师（刚接触 AI 编程）</div>
      </div>

      <div class="path">
        <div class="path-prompt"><span class="term-prompt">$</span> ./read --role=tech-lead</div>
        <div class="path-flow">
          <a href="/research/landscape">行业全景图</a>
          <span class="arr">→</span>
          <a href="/research/vibe-vs-spec">Vibe vs Spec</a>
          <span class="arr">→</span>
          <a href="/strategy/pilot-playbook">试点 Playbook</a>
          <span class="arr">→</span>
          <a href="/research/transformation">团队转型路线图</a>
          <span class="arr">→</span>
          <a href="/handbook/constitution">Constitution 模式</a>
        </div>
        <div class="path-tag"># 技术负责人 / 架构师</div>
      </div>

      <div class="path">
        <div class="path-prompt"><span class="term-prompt">$</span> ./read --role=migrator</div>
        <div class="path-flow">
          <a href="/handbook/unfamiliar-codebase">陌生代码库协作</a>
          <span class="arr">→</span>
          <a href="/research/ai-boundaries">AI 能力边界</a>
          <span class="arr">→</span>
          <a href="/handbook/parallel-sessions">多 AI 会话并行</a>
          <span class="arr">→</span>
          <a href="/handbook/async-nightly">夜间异步执行</a>
          <span class="arr">→</span>
          <a href="/handbook/docs-sync-strategy">文档同步策略</a>
        </div>
        <div class="path-tag"># 陌生代码库，需要迁移/重构</div>
      </div>
    </div>
  </section>


  <!-- Footer CTA -->
  <section class="section cta-term">
    <div class="cta-term-prompt">
      <span class="term-prompt">❯</span> <span class="term-cmd">Select next action:</span>
    </div>
    <div class="cta-actions-term">
      <a href="/research/landscape" class="btn-term btn-term-primary"><span class="btn-prefix">[1]</span> ./research/landscape</a>
      <a href="/handbook/why" class="btn-term btn-term-secondary"><span class="btn-prefix">[2]</span> ./handbook/why</a>
      <a href="https://github.com/atbeta/ai-dev-handbook" class="btn-term btn-term-ghost"><span class="btn-prefix">[3]</span> git remote -v</a>
    </div>
    <p class="cta-foot">v2.9 · 54 pages · updated 2026-07-14 · System Ready.</p>
  </section>
</MainLayout>

<style>
  /* ========== Status bar ========== */
  .statusbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-secondary);
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }
  .sb-item { white-space: nowrap; }
  .sb-sep { color: var(--c-text-muted); }
  .sb-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-green);
    display: inline-block;
    box-shadow: 0 0 6px var(--c-green);
  }

  /* ========== Terminal hero ========== */
  .terminal-hero {
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 10px;
    overflow: hidden;
    font-family: var(--font-mono);
    margin-bottom: 32px;
    box-shadow: var(--shadow-md);
  }
  
  .terminal-header {
    background: var(--c-bg-tertiary);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid var(--c-border);
  }
  
  .term-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .term-red { background: #ff5f57; }
  .term-yellow { background: #febc2e; }
  .term-green { background: #28c840; }
  .term-title {
    margin-left: 12px;
    font-size: 0.8rem;
    color: var(--c-text-muted);
    font-weight: 500;
  }
  .terminal-body {
    padding: 24px;
    color: var(--c-text);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .term-line { margin-bottom: 6px; }
  .term-prompt { color: var(--c-accent); margin-right: 8px; font-weight: bold; }
  .term-cmd { color: var(--c-text); }
  .term-output { color: var(--c-text-secondary); margin-left: 0; margin-bottom: 12px; }
  .term-log { font-size: 0.85rem; color: var(--c-text-secondary); }
  .log-ok { color: var(--c-green); font-weight: bold; }
  .log-warn { color: var(--c-orange); font-weight: bold; }
  .term-em { color: var(--c-accent); margin-top: 6px; display: block; }
  .term-em a { color: var(--c-accent); text-decoration: underline; text-underline-offset: 2px; }
  .ascii-art {
    color: var(--c-accent);
    font-size: 0.72rem;
    line-height: 1.1;
    margin: 12px 0;
    white-space: pre;
    overflow-x: auto;
    text-shadow: 0 0 8px var(--c-accent-bg);
  }

  /* ========== Section headers ========== */
  .sec-h2 {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    color: var(--c-text);
    margin-bottom: 24px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sec-bracket { color: var(--c-accent); font-weight: 300; }

  /* ========== Delivery pipeline ========== */
  .pipeline-lead {
    font-size: 0.95rem;
    color: var(--c-text-secondary);
    line-height: 1.7;
    margin: -8px 0 24px;
    max-width: 780px;
  }
  .pipeline-lead .stage-todo { margin: 0 2px; }
  .pipeline { display: flex; flex-direction: column; gap: 12px; }
  .stage {
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    padding: 16px 18px;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }
  .stage:hover {
    border-color: var(--c-border-strong);
    box-shadow: var(--shadow-md);
  }
  .stage-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }
  .stage-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c-accent);
    background: var(--c-accent-bg);
    padding: 2px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .stage-title { display: flex; flex-direction: column; gap: 2px; }
  .stage-title strong { font-size: 1.02rem; color: var(--c-text); }
  .stage-sub { font-size: 0.82rem; color: var(--c-text-muted); }
  .stage-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding-left: 2px;
  }
  .stage-links a {
    color: var(--c-accent);
    text-decoration: none;
    padding: 3px 8px;
    background: var(--c-accent-bg);
    border-radius: 4px;
    transition: all 0.15s;
  }
  .stage-links a:hover {
    background: var(--c-accent);
    color: var(--c-bg);
  }
  .stage-todo {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 3px 8px;
    border-radius: 4px;
    color: var(--c-text-muted);
    background: var(--c-bg-tertiary);
    border: 1px dashed var(--c-border);
  }

  /* ========== Insights grid ========== */
  .insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .insight-card {
    background: var(--c-bg-secondary);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    padding: 16px;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
