---
import MainLayout from '../../layouts/MainLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
---

<MainLayout title="团队角色" description="AI 辅助开发流程中各角色的职责分工和协作模式">
  <Sidebar currentPath="/handbook/team-roles" slot="sidebar" />
  <h1>团队角色与协作</h1>
  <div class="meta-line"><span class="tag">实践指南</span> 角色分工</div>

  <h2 id="roles">4 个核心角色</h2>
  <table>
    <thead><tr><th>角色</th><th>主要责任</th><th>不应做</th></tr></thead>
    <tbody>
      <tr><td><strong>PM</strong></td><td>原始需求、WHY、业务裁决</td><td>写 Spec、写代码</td></tr>
      <tr><td><strong>Spec Author</strong></td><td>把需求转成 Frozen Spec</td><td>写代码、做业务决策</td></tr>
      <tr><td><strong>Engineer</strong></td><td>把 Spec 转成代码</td><td>改 Spec、决策业务</td></tr>
      <tr><td><strong>Reviewer</strong></td><td>验证 Spec 和实现</td><td>写代码决策</td></tr>
    </tbody>
  </table>

  <h2 id="flexibility">规模适配</h2>
  <table>
    <thead><tr><th>团队规模</th><th>角色分配</th></tr></thead>
    <tbody>
      <tr><td>1 人</td><td>4 个角色全是一个人，每个阶段切换心态</td></tr>
      <tr><td>2-3 人</td><td>1 PM + 1-2 全栈（轮流做 Spec Author/Engineer/Reviewer）</td></tr>
      <tr><td>5-10 人</td><td>1 PM + 2-3 Spec Author + 3-5 Engineer + 1-2 Reviewer</td></tr>
      <tr><td>10+ 人</td><td>标准分工 + 专职 Spec Author</td></tr>
    </tbody>
  </table>

  <h2 id="ai-boundary">AI 协作的三条红线</h2>
  <ol>
    <li><strong>AI 不许写 Spec 初稿。</strong> Spec Author 必须人。</li>
    <li><strong>AI 不许做业务裁决。</strong> PM 必须人。</li>
    <li><strong>AI 不许决定「可上线」。</strong> Release Manager 必须人。</li>
  </ol>

  <h2 id="collaboration">协作反模式</h2>
  <ol>
    <li>PM 不参与 Lint → 业务意图和 Spec 偏离</li>
    <li>Engineer 跳过 Spec 评审 → 技术假设没被挑战</li>
    <li>AI 替代 Reviewer → 业务问题漏掉</li>
    <li>Spec Author 单人承担全部判断 → 漏掉跨团队影响</li>
  </ol>

</MainLayout>
